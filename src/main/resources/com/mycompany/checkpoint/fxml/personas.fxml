<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" styleClass="panel-content" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.checkpoint.ui.controllers.PersonasController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label styleClass="label-title" text="Gestión de Personas" />
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <VBox styleClass="form-container" spacing="15">
        <Label styleClass="label-subtitle" text="Agregar Nueva Persona" />
        <GridPane hgap="15" vgap="15">
            <columnConstraints>
                <ColumnConstraints minWidth="120" />
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints minWidth="120" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <Label styleClass="form-label" text="NIE:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtIdPersona" promptText="Ej: 5060636" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label styleClass="form-label" text="Nombre Completo:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="txtNombre" promptText="Nombre y apellido" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <Label styleClass="form-label" text="Correo Electrónico:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtEmail" promptText="ejemplo@escuela.edu" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label styleClass="form-label" text="Año:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <ComboBox fx:id="cmbAno" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <Label styleClass="form-label" text="Sección:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <ComboBox fx:id="cmbSeccion" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label styleClass="form-label" text="Sexo:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <ComboBox fx:id="cmbSexo" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="2" />

            <Label styleClass="form-label" text="Especialidad:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <ComboBox fx:id="cmbEspecialidad" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label styleClass="form-label" text="Estado:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <ComboBox fx:id="cmbEstado" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="3" />
        </GridPane>
        
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Label fx:id="lblEstado" text="" />
            <Button fx:id="btnImportarExcel" text="📥 Importar desde Excel" 
                    onAction="#handleImportarExcel"
                    style="-fx-background-color: #163A78; -fx-text-fill: white; -fx-padding: 8 15; -fx-font-weight: bold;"/>
            <Button fx:id="btnAgregar" mnemonicParsing="false" styleClass="button-primary" text="➕ Agregar Persona" />
        </HBox>
    </VBox>

    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="label-subtitle" text="Directorio Registrado" />
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtBuscar" promptText="🔍 Buscar..." prefWidth="250" />
        </HBox>
        
        <TableView fx:id="tablePersonas" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colID" prefWidth="100.0" text="NIE" />
                <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre Completo" />
                <TableColumn fx:id="colEmail" prefWidth="180.0" text="Correo Electrónico" />
                
                <TableColumn fx:id="colAno" prefWidth="90.0" text="Año" />
                
                <TableColumn fx:id="colSeccion" prefWidth="80.0" text="Sección" />
                <TableColumn fx:id="colSexo" prefWidth="90.0" text="Sexo" />
                <TableColumn fx:id="colEspecialidad" prefWidth="160.0" text="Especialidad" />
                <TableColumn fx:id="colEstado" prefWidth="90.0" text="Estado" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>