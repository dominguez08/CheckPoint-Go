<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.checkpoint.ui.controllers.MainController">

    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" minWidth="220" prefWidth="240">
            <padding>
                <Insets top="25" left="15" right="15" bottom="25"/>
            </padding>

            <Label text="CheckPoint Go" styleClass="sidebar-title"/>
            <Label text="Control de Entrada y Salida" styleClass="sidebar-subtitle"/>

            <Region prefHeight="20"/>

            <Button fx:id="btnResumen"
                    text="📊 Resumen"
                    styleClass="sidebar-button"
                    minHeight="45"
                    maxWidth="Infinity"/>
                    
            <Region prefHeight="8"/>

            <Button fx:id="btnRegistro"
                    text="📝 Registros"
                    styleClass="sidebar-button"
                    minHeight="45"
                    maxWidth="Infinity"/>
                    
            <Region prefHeight="8"/>

            <Button fx:id="btnPersonas"
                    text="👥 Estudiantes"
                    styleClass="sidebar-button"
                    minHeight="45"
                    maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label fx:id="lblEstado"
                   text="🔄 Verificando..."
                   style="-fx-text-fill: #F59E0B; -fx-padding: 0 0 5 15; -fx-font-size: 12px; -fx-font-weight: bold;"/>

            <Label fx:id="lblUsuario"
                   text="Usuario: Admin"
                   styleClass="sidebar-text-small"
                   style="-fx-text-fill: #94A3B8; -fx-padding: 0 0 10 15; -fx-font-weight: bold;"/>

            <Button fx:id="btnLogout"
                    text="🚪 Cerrar Sesión"
                    styleClass="sidebar-button"
                    minHeight="40"
                    maxWidth="Infinity"
                    style="-fx-background-color: rgba(239, 68, 68, 0.1); -fx-text-fill: #FCA5A5;"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea"
                   style="-fx-background-color: #F8FAFC;"/>
    </center>

</BorderPane>